# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/cortinho
# Session pooler / direct connection used by drizzle-kit (Supabase: port 5432, not 6543)
DIRECT_URL=postgresql://user:password@localhost:5432/cortinho

# ── Clerk ─────────────────────────────────────────────────────
# Found in Clerk dashboard → API Keys
CLERK_INSTANCE=your-clerk-instance.clerk.accounts.dev

# Found in Clerk dashboard → Webhooks → signing secret
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AI ────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated. iOS native apps don't need an entry here.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,https://cortinho.com

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AI_RATE_LIMIT_MAX=10

# ── Redis (optional — uses in-process cache if not set) ───────
# REDIS_URL=redis://localhost:6379

# ── External pricing ──────────────────────────────────────────
# PRICECHARTING_TOKEN=your_token_here

# ── PSA ───────────────────────────────────────────────────────
# Public API token from https://www.psacard.com/publicapi (free tier: 100 calls/day)
PSA_API_TOKEN=
PSA_RATE_LIMIT_MAX=10

# ── CGC (via parse.bot) ───────────────────────────────────────
# API key from parse.bot/settings. Scraper ID defaults to the CGC cert scraper.
PARSE_API_KEY=
PARSE_CGC_SCRAPER_ID=139b9b93-f52f-4c61-824f-4b9e918d0aa1
CGC_RATE_LIMIT_MAX=10

# ── eBay (sold-listing prices) ────────────────────────────────
# developer.ebay.com → Application Keys. App ID = client id, Cert ID = client secret.
# Sold-listing data uses the Marketplace Insights API, which eBay must approve.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_SANDBOX=false

# External cron for daily price snapshots (GitHub Actions → POST /internal/price-snapshot).
# When set, the in-process hourly timer is disabled. Generate with: openssl rand -hex 32
# CRON_SECRET=

# ── Sentry (optional error tracking) ──────────────────────────
# Leave empty to disable. Captures 5xx errors from the global error handler.
# SENTRY_DSN=

# Web Push for notifications on phones/desktops (unset = in-app bell only).
# Generate once: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourdomain.com

# Cap on anonymous /api/public/comps requests per day (all visitors combined)
# COMPS_DAILY_MAX=1000
